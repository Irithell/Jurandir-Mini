{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "checkJs": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "paths": {
      "@/types/*": ["./src/types/*"]
    }
  },
  "exclude": ["node_modules", "database", "tmp"]
}
